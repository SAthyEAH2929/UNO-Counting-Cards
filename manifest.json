{
  "name": "UNO Board Showdown — Snakes, Ladders & Traps",
  "short_name": "UNO Race",
  "description": "Multiplayer board race game where you draw UNO cards instead of rolling dice! 46, 100, and 200 tiles modes with traps, Ludo knockouts, animated runners, and Android TV remote support.",
  "start_url": "/",
  "id": "/?source=pwa",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "fullscreen"],
  "orientation": "any",
  "background_color": "#060913",
  "theme_color": "#060913",
  "categories": ["games", "entertainment", "strategy"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.vercel.uno_snakes_ladders_traps_multiplaye.twa",
      "id": "app.vercel.uno_snakes_ladders_traps_multiplaye.twa"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "handle_links": "preferred",
  "scope_extensions": [
    { "origin": "https://uno-snakes-ladders-traps-multiplaye.vercel.app" },
    { "origin": "https://uno-counting-cards-narp.onrender.com" }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+unorace",
      "url": "/?room=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
  "note_taking": {
    "new_note_url": "/?note=new"
  },
  "widgets": [
    {
      "name": "UNO Race Quick Stats",
      "short_name": "UNO Stats",
      "description": "Quick active match status and leaderboard",
      "tag": "uno-race-stats",
      "template": "uno-stats-template",
      "ms_ac_template": "widgets/stats.json",
      "data": "widgets/stats-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-mobile.png",
          "sizes": "720x1280",
          "label": "Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "icons": [
    {
      "src": "/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
